# Copy to .env - docker compose picks it up automatically.

# On the test and production systems: makes docker compose use the deployment file, so
# plain "docker compose up -d --build" is enough and nobody has to remember -f. Leave it
# commented out on development machines, they use docker-compose.yml.
#COMPOSE_FILE=docker-compose.prod.yml

# Public base URL of the H5P server. It ends up in the asset and callback URLs of the
# player, so it has to be the URL the browser can reach, not the internal one.
# docker-compose.yml falls back to http://localhost:3000 without it,
# docker-compose.prod.yml refuses to start.
H5P_BASE_URL=https://subdomain.domain.de/h5p

# Which interaction types the h5p-bootstrap job installs from the H5P Hub.
# "all" installs the whole catalogue; alternatively a comma separated list of machine
# names, e.g. H5P.MultiChoice,H5P.CoursePresentation,H5P.InteractiveVideo
#H5P_BOOTSTRAP_LIBRARIES=all
# Retries per content type before it counts as failed
#H5P_BOOTSTRAP_RETRIES=3
# "true" also updates content types that are installed but outdated
#H5P_BOOTSTRAP_UPDATE=false
