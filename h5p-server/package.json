{
  "name": "h5p-server",
  "version": "1.0.2",
  "description": "Modern H5P server using @lumieducation/h5p-server",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "dependencies": {
    "@lumieducation/h5p-express": "^10.0.5",
    "@lumieducation/h5p-server": "^10.0.4",
    "ajv": "^8.20.0",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "fast-uri": "^3.1.8",
    "image-size": "^2.0.4",
    "jsonpath": "^1.3.0",
    "multer": "^2.4.0"
  },
  "overrides": {
    "@lumieducation/h5p-express": {
      "express": "4.22.3",
      "body-parser": "1.20.8",
      "path-to-regexp": "0.1.13"
    },
    "underscore": "1.13.8",
    "proxy-addr": "2.0.8",
    "image-size": "$image-size",
    "fast-uri": "$fast-uri",
    "postcss": "8.5.29",
    "nanoid": "3.3.20",
    "qs": "6.16.0",
    "sanitize-html": "2.18.0",
    "axios": "1.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
